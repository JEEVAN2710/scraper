# ==============================================================================
# Financial AI Assistant Configuration
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# Application
APP_NAME=Financial-AI-Assistant
ENVIRONMENT=development
LOG_LEVEL=INFO

# MySQL Database Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=financial_ai
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_POOL_SIZE=5
MYSQL_POOL_NAME=financial_ai_pool
MYSQL_CONNECT_TIMEOUT=10

# Ollama LLM Configuration (Phase 4)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT=60
OLLAMA_MAX_RETRIES=3

# Storage Paths
DOWNLOAD_DIR=data/downloads
PROCESSED_DIR=data/processed
EXPORT_DIR=data/exports
LOGS_DIR=logs

# Document Processing & Chunking Parameters (Phase 3)
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
OCR_FALLBACK_MIN_WORDS=20
OCR_LANGUAGE=eng

# API Configuration (Phase 7)
API_HOST=0.0.0.0
API_PORT=8000
